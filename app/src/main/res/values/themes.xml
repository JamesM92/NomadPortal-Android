<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose owns the actual UI theming
         (see ui/theme/Theme.kt) — this just needs to exist for the window's
         pre-Compose launch state (splash background, status bar) and to
         satisfy the manifest reference. -->
    <style name="Theme.NomadPortal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nomad_bg</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/nomad_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/nomad_bg</item>
    </style>
</resources>
