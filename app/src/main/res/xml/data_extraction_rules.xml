<?xml version="1.0" encoding="utf-8"?>
<!--
  android:allowBackup="false" (AndroidManifest.xml) already blocks legacy
  full backup, but Android 12+ splits cloud-backup and device-to-device
  transfer into two separately-configurable channels via this file. Both are
  excluded here, explicitly and completely: this app's private storage
  holds RNS/LXMF identity key material (porting-notes.md §3's trust model —
  "your own identity" is exactly the thing that must never leave the device
  through a side channel neither the app nor the user directly controls).
  Don't add <include>/<exclude> rules that carve out exceptions without
  reconsidering that reasoning first.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
