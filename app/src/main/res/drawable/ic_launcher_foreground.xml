<?xml version="1.0" encoding="utf-8"?>
<!-- The app's real mark (AppLogo.kt's TentPortalMark), not the old
     terminal-prompt placeholder — see that composable's own doc comment
     for the design rationale (a camping-tent silhouette with a purple
     portal-doorway arch). Reproduced here as static vector paths rather
     than referencing the Compose composable directly (launcher icons are
     resolved by the system/launcher process, outside this app's own
     Compose tree, so there's no way to reuse the runtime drawing code
     as-is); coordinates are TentPortalMark's own fractional geometry,
     scaled into the standard 66dp adaptive-icon safe zone (centered in
     this 108dp viewport, 21dp margin each side) rather than filling the
     full 108dp canvas edge to edge, so the shape survives every standard
     launcher mask (circle, squircle, rounded square, teardrop) without
     the guy-line stakes sitting exactly on the crop boundary. Colors
     match the real theme values exactly: NomadAccent (#5ba3c9, tent),
     NomadPortalPurple (#9b6bc8, doorway), and the same 0.6x-darkened
     tentColor (#366178) TentPortalMark itself computes for the seam/guy
     lines. Keep this in sync with AppLogo.kt's own geometry if that
     composable's proportions ever change. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Tent silhouette (filled) -->
    <path
        android:fillColor="#5ba3c9"
        android:pathData="M34.2,79.08 L34.2,57.3 L54,26.28 L73.8,57.3 L73.8,79.08 Z" />
    <!-- Ridge seam + guy lines (stroked, round caps — matches
         TentPortalMark's own StrokeCap.Round) -->
    <path
        android:strokeColor="#366178"
        android:strokeWidth="3.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,26.28 L54,61.92 M44.1,41.79 L23.64,85.68 M63.9,41.79 L84.36,85.68" />
    <!-- Portal doorway: flat sides + semicircular arch top, filled -->
    <path
        android:fillColor="#9b6bc8"
        android:pathData="M43.44,79.08 L43.44,61.92 A10.56,10.56 0 0,1 64.56,61.92 L64.56,79.08 Z" />
</vector>
