<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local Wi-Fi discovery (RNS's AutoInterface — IPv6 link-local
         multicast, see connectivity/InterfaceController.kt). A normal
         install-time permission, not a runtime-prompted one — Android
         drops multicast packets by default without it, but it doesn't
         touch Wi-Fi scanning, location, or anything dangerous-protection-
         level. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Bluetooth-mesh / RNode-over-Bluetooth support. Both are optional at
         runtime (see permissions/BluetoothPermissions.kt) — the app must
         function fully with either denied, per
         nomadportal_android_handoff.md's connectivity/privacy section.
         usesPermissionFlags="neverForLocation" on BLUETOOTH_SCAN is why
         minSdk is 31 (app/build.gradle.kts): that flag is what lets this
         app scan for BLE devices without ever requesting location, which
         is only possible on API 31+. Never add
         ACCESS_FINE_LOCATION/ACCESS_COARSE_LOCATION to this manifest. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <application
        android:name=".NomadPortalApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NomadPortal">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exposes received/sent message attachments (stored under
             getNoBackupFilesDir()/reticulum/lxmf/attachments — see
             messaging.py's own doc comment for why they live there,
             same never-backed-up storage root as everything else this
             app persists) to the system share sheet / other apps via a
             content:// URI, without granting broader filesystem access
             than the specific file being shared — FileProvider itself
             only ever exposes a URI when AttachmentFileProvider.kt
             explicitly builds one for a single real file, root-path
             below is just which directories are eligible to have a URI
             built for them at all. root-path (not files-path) because
             getNoBackupFilesDir() has no dedicated named path type in
             FileProvider's own schema, unlike getFilesDir()/
             getCacheDir() — see res/xml/file_paths.xml's own comment. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
